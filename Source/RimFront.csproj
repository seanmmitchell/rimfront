<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <AssemblyName>RimFront</AssemblyName>
    <RootNamespace>RimFront</RootNamespace>
    <Version>0.5.8</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>../mod/$(RimWorldVersion)/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RW17</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17Dir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorld17Dir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith.UnityCompat"><HintPath>$(RimWorld17Dir)/Waylith.UnityCompat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorld17Dir)/Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Harmony17Dir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateGameVersion" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and '$(RimWorldVersion)' != '1.7'" Text="RimWorldVersion must be 1.6 or 1.7." />
    <Error Condition="'$(RimWorldVersion)' == '1.7' and !Exists('$(RimWorld17Dir)/Assembly-CSharp.dll')" Text="Set RimWorld17Dir to your legally installed RimWorld 1.7 directory." />
    <Error Condition="'$(RimWorldVersion)' == '1.7' and !Exists('$(Harmony17Dir)/0Harmony.dll')" Text="Set Harmony17Dir to Harmony's 1.7/Assemblies directory." />
  </Target>
</Project>
