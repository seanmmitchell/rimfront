<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RimFrontSource Condition="'$(RimFrontSource)' == ''">../../Source</RimFrontSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="EngineBoundary.cs" />
    <Compile Include="MultiplayerBoundary.cs" />
    <Compile Include="MathBoundary.cs" />
    <Compile Include="$(RimFrontSource)/NativeAimTargeting.cs" Link="NativeAimTargeting.cs" />
    <Compile Include="$(RimFrontSource)/NativeMountains.cs" Link="NativeMountains.cs" />
    <Compile Include="$(RimFrontSource)/MountainProfile.cs" Link="MountainProfile.cs" />
    <Compile Include="$(RimFrontSource)/MountainSurfaceCache.cs" Link="MountainSurfaceCache.cs" />
    <Compile Include="$(RimFrontSource)/NearestCandidates.cs" Link="NearestCandidates.cs" />
    <Compile Include="$(RimFrontSource)/AimGeometry.cs" Link="AimGeometry.cs" />
  </ItemGroup>
</Project>
